# Server only. Never expose service keys in saas-config.js or browser storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RADAR_INTERNAL_SECRET=
RADAR_MODEL=
# One explicit workspace for scheduled background scans.
RADAR_SCHEDULE_WORKSPACE_ID=
MPR_PAID_PROVIDER_CALLS_ENABLED=false
MPR_PAID_BILLING_ENABLED=false
# Current Free Top 25 sources. A source remains fail-closed until its public-display
# terms have been reviewed and the matching approval flag is explicitly enabled.
MPR_INTERNAL_REFRESH_SECRET=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
MPR_EBAY_TERMS_APPROVED=false
MPR_EBAY_PRODUCTION_ACCESS_APPROVED=false
MPR_EBAY_PUBLIC_DISPLAY_APPROVED=false
MPR_EBAY_CROSS_MARKET_TARGETS_JSON=[]
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_ASSOCIATE_TAG=
MPR_AMAZON_CREATORS_TERMS_APPROVED=false
MPR_AMAZON_PUBLIC_DISPLAY_APPROVED=false
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
MPR_ALIEXPRESS_TERMS_APPROVED=false
MPR_ALIEXPRESS_PUBLIC_DISPLAY_APPROVED=false
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
MPR_GOOGLE_KEYWORD_DATA_APPROVED=false
TIKTOK_COMMERCIAL_CLIENT_KEY=
TIKTOK_COMMERCIAL_CLIENT_SECRET=
MPR_TIKTOK_COMMERCIAL_TERMS_APPROVED=false
MPR_TIKTOK_PUBLIC_DISPLAY_APPROVED=false
MPR_ROMANIA_PUBLIC_DISPLAY_APPROVED=false
